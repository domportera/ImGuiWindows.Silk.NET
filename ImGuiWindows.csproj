<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Deterministic>true</Deterministic>
        <PublishAot>true</PublishAot>
        <RootNamespace>ImGuiWindows</RootNamespace>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>

        <!-- allow transitive dependencies to be used in projects that depend on us-->
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Silk.NET\sources\Core\Core\Silk.NET.Core.csproj"/>
        <ProjectReference Include="..\Silk.NET\sources\Input\Input\Silk.NET.Input.csproj"/>
        <ProjectReference Include="..\Silk.NET\sources\Maths\Maths\Silk.NET.Maths.csproj"/>
        <ProjectReference Include="..\Silk.NET\sources\Windowing\Windowing\Silk.NET.Windowing.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="ImGui.NET" Version="1.91.6.1"/>
        <PackageReference Include="XenoAtom.Ansi" Version="1.6.0"/>
        <PackageReference Include="XenoAtom.Logging" Version="1.1.2"/>
        <PackageReference Include="XenoAtom.Logging.Terminal" Version="1.1.2" />
        <PackageReference Include="XenoAtom.Terminal" Version="1.8.0" />
        <PackageReference Include="XenoAtom.Terminal.UI" Version="1.5.2" />
    </ItemGroup>

    <ItemGroup>
      <Reference Include="XenoAtom.Logging.Terminal">
        <HintPath Condition=" '$(Configuration)' == 'Debug' ">bin\Debug\net10.0\XenoAtom.Logging.Terminal.dll</HintPath>
        <HintPath Condition=" '$(Configuration)' == 'Release' ">bin\Release\net10.0\XenoAtom.Logging.Terminal.dll</HintPath>
      </Reference>
    </ItemGroup>

</Project>